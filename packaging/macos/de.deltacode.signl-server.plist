<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Autostart bei der Anmeldung:
       cp signl-server /usr/local/bin/
       cp de.deltacode.signl-server.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/de.deltacode.signl-server.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>de.deltacode.signl-server</string>
  <key>ProgramArguments</key><array><string>/usr/local/bin/signl-server</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/signl-server.log</string>
  <key>StandardErrorPath</key><string>/tmp/signl-server.log</string>
</dict>
</plist>
